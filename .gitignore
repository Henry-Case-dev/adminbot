# ── Секреты и чувствительные данные ──────────────────────────────
.env
.env.bak*
.env.*
!.env.example
check_remote_bot.py
deploy_*.py
*.pem
id_rsa*
id_ed25519*
media/*cookies*
*cookies*.txt
*.cookies
deploy_result.json
# Локальная БД (переписка/пользователи) и файлы деплой-команд — не в git
*.db
deploy_commands.txt

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
dist/
build/

# ── Логи ──────────────────────────────────────────────────────────
logs/
*.log

# ── Браузерные профили (куки, сессии, логины) ────────────────────
chrome-profile/
bot-chrome-profile/

# ── Бэкапы и временные файлы ──────────────────────────────────────
backups/
*.swp
*.tmp

# ── IDE / ОС ──────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Docker runtime data (Epic 66, D263) ────────────────────────────
# данные авторизации Bot API не в git; сам каталог держим через .gitkeep
docker/telegram-bot-api/*
!docker/telegram-bot-api/.gitkeep
