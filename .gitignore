# ── Секреты и чувствительные данные ──────────────────────────────
.env
.env.bak*
.env.*
!.env.example
check_remote_bot.py
deploy_*.py
*.pem
id_rsa*
id_ed25519*
media/*cookies*
*cookies*.txt
*.cookies
deploy_result.json
# Локальная БД (переписка/пользователи) и файлы деплой-команд — не в git
*.db
# SQLite WAL/SHM runtime-файлы (в т.ч. воркера импорта истории) — не в git
*.db-wal
*.db-shm
deploy_commands.txt

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
dist/
build/

# ── Логи ──────────────────────────────────────────────────────────
logs/
*.log

# ── Браузерные профили (куки, сессии, логины) ────────────────────
chrome-profile/
bot-chrome-profile/

# ── Бэкапы и временные файлы ──────────────────────────────────────
backups/
*.swp
*.tmp

# ── Импорт истории Telegram (раунд 4, T-723): ~600 МБ, НЕ в git ──
migrate_history/

# ── Сторонний референс-сайт Relume (редизайн TMA, раунд 10.5) ──────
# relumesite_example/ — сгенерированный Relume экспорт сайта-мокапа
# (референс дизайна админки). Не код проекта, в git не нужен.
# ВНИМАНИЕ: media/ — НЕ трогать (политика project.md: медиа для сервера).
relumesite_example/

# ── Тяжёлый исходник шрифта Material Symbols (редизайн TMA, OD18) ──
# MaterialSymbolsRounded[FILL,GRAD,opsz,wght].woff2 (~5.11 МиБ) в корне —
# исходник для сборки сабсета. В git НЕ коммитим.
# В git идёт только сабсет ~13 КБ (web/static/fonts/material-symbols-rounded.woff2)
# + LICENSE (Apache-2.0). Паттерн без '[' / ']' — скобки в gitignore спецсимволы.
# ВНИМАНИЕ: media/ — НЕ трогать (политика project.md: медиа для сервера).
MaterialSymbolsRounded*.woff2

# ── Личный вход владельца: ТЗ текущего раунда (не для git) ────────
# plans/current_task.md — рабочий файл владельца с ТЗ раунда;
# в git не коммитится (его содержимое переносится в plans/features/*/tasks.md).
plans/current_task.md

# ── IDE / ОС ──────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Docker runtime data (Epic 66, D263) ────────────────────────────
# данные авторизации Bot API не в git; сам каталог держим через .gitkeep
docker/telegram-bot-api/*
!docker/telegram-bot-api/.gitkeep

# ── Локальное состоянии истории ключей (редизайн 10.5, OD19) ──────
# var/status_key_history.json — leak-safe снимок доступности ключей
# (allowlist: module_id/provider/model/ok/http_status/ts). Файл НЕ в git.
var/

# ── Промежуточные артефакты сборки шрифта (T-1146) ──────────────
# build/ — instanced-ttf, subset_unicodes.txt, маркер sha256 источника.
build/

# ── Артефакты UI-аудита (раунд 10.21, F6; S10.21-9) ─────────────
# Бинарные скриншоты (~9 МБ) и сырой JSON-прогон в git НЕ коммитим.
# В репо остаются только tools/ui_audit_round1021.py и UI_AUDIT_REPORT.md.
tools/_ui_audit_shots/
tools/_ui_audit_raw.json

# ── Артефакты Playwright-матрицы shell (раунд 10.25, F1; T-2407) ──
# Бинарные скриншоты и сырой JSON-прогон в git НЕ коммитим.
# В репо остаётся только tools/ui_round1025_matrix.py.
tools/_ui_round1025_shots/
tools/_ui_round1025_raw.json
# F10 round1025 (T-3126): скриншоты сводной приёмки Эпика 1 (8 PNG, ~1 МБ) —
# локальные артефакты прогонов, в git НЕ коммитим.
plans/reports/round1025_f10_shots/

# ── Крупные архивы исходников/бэкапов (round1025 hotfix, T-2460) ──
# bot.zip / admin_bot.zip / adminbot.zip (~0.9 ГБ суммарно) — локальные
# архивы, в git НЕ коммитить и НЕ удалять (владелец).
*.zip

# ══ round1025 hotfix9 (ADR-1025-17 D5/D6): npm — только инструмент сборки ══
# Готовые bundles лежат в web/static/vendor/ (коммитятся); node_modules сборки — нет.
tools/vendor/node_modules/

# ══ round1025 hotfix9 (T-2816/T-2829): артефакты стеклянного прототипа (скриншоты/probe.json) ══
tools/_hotfix9_glass_probe/
