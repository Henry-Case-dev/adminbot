+def _explicit_year_message_keywords(keywords: list[str]) -> list[str]:
+    """Узкий content-match explicit-year message-поиска (RC2/D3).
+
+    Год уже применён структурным `time_from/time_to`; 4-значный год,
+    годовые слова и служебные предлоги/местоимения не должны формировать
+    FTS-пул иначе `order='time'`/шумный rank выбирает нерелевантные
+    сообщения. Списка тем здесь нет — только служебные токены.
+    """
+    out: list[str] = []
+    for word in keywords or ():
+        token = str(word or "").casefold()
+        if not token:
+            continue
+        if _YEAR_IN_QUERY_RE.fullmatch(token):
+            continue
+        if token in _YEAR_WORD_TOKENS:
+            continue
+        if token in _MESSAGE_WINDOW_STOPWORDS:
+            continue
+        if token not in out:
+            out.append(token)
+    return out
+
+
+_MESSAGE_WINDOW_STOPWORDS = frozenset({
+    "а", "без", "бы", "в", "вам", "вас", "вот", "все", "всё", "вы", "где",
+    "да", "даже", "для", "до", "его", "ее", "её", "ей", "если", "есть",
+    "же", "за", "и", "из", "или", "им", "их", "к", "как", "какая", "какие",
+    "какой", "ко", "когда", "кто", "ли", "между", "меня", "мне", "мы",
+    "на", "над", "нас", "не", "него", "нее", "ней", "ни", "ним", "них",
+    "но", "о", "об", "он", "она", "они", "от", "по", "под", "при", "про",
+    "с", "себе", "со", "так", "там", "тебе", "то", "тогда", "тот", "тут",
+    "у", "чего", "чем", "через", "что", "чтобы", "эта", "эти", "это",
+    "этот", "я",
+})
+_YEAR_WORD_TOKENS = frozenset({
+    "год", "года", "годе", "годов", "годом", "году", "годы", "годах",
+})
+
+
+def _explicit_year_message_match(keywords: list[str]) -> str:
+    """Узкий selective FTS-match explicit-year message-поиска (RC2/D3).
+
+    Требует co-occurrence минимум двух content-основ (OR по парам AND), чтобы
+    короткие сообщения с одним общим словом не забивали rank. При одной
+    основе — обычный prefix. Списка тем нет; только служебные токены
+    отфильтрованы `_explicit_year_message_keywords`.
+    """
+    tokens = _explicit_year_message_keywords(keywords)
+    if not tokens:
+        return ""
+    from services.text_morphology import stem_word
+    terms: list[str] = []
+    for token in tokens:
+        stem = str(stem_word(token) or token)
+        term = stem if len(stem) >= 4 else token
+        term = term.replace('"', "").replace("*", "")
+        if term and term not in terms:
+            terms.append(term)
+    terms = terms[:8]
+    if not terms:
+        return ""
+    if len(terms) == 1:
+        return f'"{terms[0]}"*'
+    pairs: list[str] = []
+    for i, first in enumerate(terms):
+        for second in terms[i + 1:]:
+            pairs.append(f'("{first}"* AND "{second}"*)')
+    return " OR ".join(pairs)
+
+
+def _window_chunks(start: int, end: int, parts: int = 4) -> list[tuple[int, int]]:
+    """Bounded disjoint time chunks для explicit-year rank (RC2)."""
+    start, end = int(start), int(end)
+    if end <= start:
+        return [(start, end)]
+    span = end - start + 1
+    parts = max(1, min(int(parts), 8))
+    step = max(1, span // parts)
+    chunks: list[tuple[int, int]] = []
+    cursor = start
+    for _ in range(parts):
+        chunk_end = min(end, cursor + step - 1)
+        if chunk_end < cursor:
+            break
+        chunks.append((cursor, chunk_end))
+        cursor = chunk_end + 1
+        if cursor > end:
+            break
+    if not chunks or chunks[-1][1] < end:
+        chunks.append((max(start, chunks[-1][1] + 1 if chunks else start), end))
+    return chunks
+
+
+async def _ranked_message_rows(db, chat_id: int, match_query: str, limit: int,
+                               since_ts: int, until_ts: int,
+                               fetch_k: int) -> list:
+    """Bounded candidate chunks + FTS rank only for candidate rowids (RC2).
+
+    Полный `ORDER BY rank` по году дорог; здесь time-index candidate cap по
+    каждому bounded chunk, затем rank только для этих rowid. Это честный
+    sampling: `candidate_cap` ограничивает пул, финальный порядок — rank.
+    """
+    reader = getattr(db, "search_messages_fts_ranked_window", None)
+    if not callable(reader):
+        return await db.search_messages_fts(
+            int(chat_id), match_query, max(1, int(limit)),
+            since_ts=int(since_ts), until_ts=int(until_ts), order="rank")
+    cap = max(64, int(fetch_k) * 8)
+    rows: list = []
+    for chunk_start, chunk_end in _window_chunks(since_ts, until_ts):
+        try:
+            chunk = await reader(
+                int(chat_id), match_query, max(1, int(limit)),
+                chunk_start, chunk_end, candidate_cap=cap)
+        except TypeError:
+            chunk = await reader(
+                int(chat_id), match_query, max(1, int(limit)),
+                chunk_start, chunk_end)
+        rows.extend(chunk or ())
+    seen: set = set()
+    unique: list = []
+    for row in rows:
+        key = _row_get(row, "id")
+        if key in seen:
+            continue
+        seen.add(key)
+        unique.append(row)
+    if any(_row_get(row, "_fts_rank", None) is not None
+           for row in unique):
+        unique.sort(key=lambda row: (
+            float(_row_get(row, "_fts_rank", 0.0) or 0.0),
+            int(_row_get(row, "id", 0) or 0)))
+    return unique[:max(1, int(limit))]
+
+
diff --git a/tests/test_vmq_mem_rc2_message_rank.py b/tests/test_vmq_mem_rc2_message_rank.py
new file mode 100644
index 000000000..9dbaacccd
--- /dev/null
+++ b/tests/test_vmq_mem_rc2_message_rank.py
@@ -0,0 +1,109 @@
+"""VMQ-MEM RC2 (D3): explicit-year message rank inside a bounded window."""
+import datetime
+import time
+
+import pytest
+
+from services.database import DatabaseService
+from services.direct_chat_service import DirectChatService
+from services.mca_retrieval_context import (
+    RetrievalRequest,
+    retrieve,
+    year_time_bounds,
+)
+from services.summary_aliases import AliasResolver
+
+CHAT = -1002661910336
+UID = 42
+TARGET_TEXT = "Ну вот был у меня конфликт с Олей, но оба себя нормально повели"
+QUERY = "что известно о конфликте Корсара с Олей в 2025 году?"
+
+
+def _ts(year, month, day, hour=12):
+    return int(datetime.datetime(
+        year, month, day, hour, tzinfo=datetime.timezone.utc).timestamp())
+
+
+async def _db(tmp_path):
+    db = DatabaseService(str(tmp_path / "rc2.db"))
+    await db.initialize()
+    return db
+
+
+async def _seed(db):
+    target = await db.save_smart_message(
+        UID, CHAT, TARGET_TEXT, None, _ts(2025, 4, 5), "text", "Оля")
+    # December 2025 messages match the OLD full query via "2025"/"году" but
+    # carry no conflict/Olya content. They must not fill the new rank window.
+    december = []
+    for day in range(1, 21):
+        december.append(await db.save_smart_message(
+            UID, CHAT, f"в 2025 году всё спокойно, день {day}", None,
+            _ts(2025, 12, day), "text", "Гений"))
+    old_2024 = await db.save_smart_message(
+        UID, CHAT, "в 2024 году был конфликт с Олей", None,
+        _ts(2024, 6, 1), "text", "Гений")
+    old_2026 = await db.save_smart_message(
+        UID, CHAT, "в 2026 году был конфликт с Олей", None,
+        _ts(2026, 1, 1), "text", "Гений")
+    return target, december, old_2024, old_2026
+
+
+async def _retrieve(db, rank: bool):
+    bounds = year_time_bounds(2025)
+    started = time.perf_counter()
+    result = await retrieve(db, None, RetrievalRequest(
+        chat_id=CHAT, query=QUERY, mode="history", top_k=8,
+        channels=("lexical",), no_age_bias=True,
+        time_from=bounds[0], time_to=bounds[1],
+        lexical_time_window=True, lexical_window_rank=rank,
+        include_self=True, include_direct_reply=True,
+        memory_scope="auto"))
+    return result, (time.perf_counter() - started) * 1000
+
+
+def _message_ids(result):
+    return [int(c.entity_id) for c in result.candidates or ()
+            if c.entity_type == "message"]
+
+
+@pytest.mark.asyncio
+async def test_rc2_explicit_year_rank_finds_april_not_december(tmp_path):
+    db = await _db(tmp_path)
+    try:
+        target, december, old_2024, old_2026 = await _seed(db)
+        old_result, _old_ms = await _retrieve(db, False)
+        old_ids = _message_ids(old_result)
+        # RED: order="time" + full query returns December, not April target.
+        assert target not in old_ids
+        assert set(old_ids) & set(december)
+
+        new_result, new_ms = await _retrieve(db, True)
+        new_ids = _message_ids(new_result)
+        # GREEN: narrow content match + rank inside the 2025 window.
+        assert target in new_ids[:8]
+        assert old_2024 not in new_ids
+        assert old_2026 not in new_ids
+        assert not (set(new_ids) & set(december))
+        assert new_ms < 2000, new_ms
+    finally:
+        await db.close()
+
+
+@pytest.mark.asyncio
+async def test_rc2_build_old_episodes_uses_rank_window(tmp_path):
+    db = await _db(tmp_path)
+    try:
+        target, december, _old_2024, _old_2026 = await _seed(db)
+        service = DirectChatService(memory=None, db=db, llm=None,
+                                    aliases=AliasResolver("{}"))
+        block, stats = await service._build_old_episodes(
+            CHAT, QUERY, [], {})
+        assert block.startswith("<Old_Episode>")
+        assert stats["year_window"] == [2025]
+        assert stats["year_window_order"] == "rank"
+        assert TARGET_TEXT[:40] in block
+        assert stats["count"] >= 1
+        assert stats["spans"]
+    finally:
+        await db.close()
