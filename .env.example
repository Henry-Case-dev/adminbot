# Telegram Bot Token (REQUIRED)
API_TOKEN=your_telegram_bot_token_here

# Database path (optional, default: local_database.db)
DB_PATH=local_database.db

# Media directory (optional, default: media)
MEDIA_BASE=media

# User IDs (optional, defaults below)
SLAVIK_USER_ID=479167456
KOSTIK_USER_ID=350803143
ALAN_USER_ID=138811255

# Alan reply interval — bot replies with random phrase every N messages (optional, default: 10)
ALAN_REPLY_INTERVAL=10
# Epic 52 (T-408): reply-блок Алана (рандомные фразы). false = молчит, F7v2 жив.
# Прод: false (T-416).
ALAN_REPLIES_ENABLED=True

# Kostik reply probability — 0.0 to 1.0 (optional, default: 1.0 = reply to every message)
KOSTIK_REPLY_PROBABILITY=1.0

# Dead Page V2 — Repost-triggered (optional, defaults below)
DEAD_PAGE_SOURCE_CHANNEL_USERNAME=d_pages
DEAD_PAGE_SOURCE_CHANNEL_ID=0
DEAD_PAGE_RELAY_CHANNEL_ID=-1004228645624
DEAD_PAGE_CAPTION_MAX_CHARS=1024
DEAD_PAGE_COOLDOWN=10s
DEAD_PAGE_POST_ON_JOIN=False
DEAD_PAGE_MAX_FORWARD_RETRIES=5

# GIF — send mp4 every N messages (optional, default: 5)
# Файл: media/slavik/slavic_chlen.mp4 (переехал из media/ в v2.15.0)
# interval <= 0 = гифка выключена (guard, WARNING в лог)
GIF_INTERVAL=5
GIF_PATH=media/slavik/slavic_chlen.mp4

# Dead page media directory (optional)
DEAD_PAGE_DIR=media/dead_page

# Alan greeting video (F7) — random video sent when Alan joins (optional, defaults below)
ALAN_USERNAME=@Alan_Z
ALAN_GREETING_DIR=media/leha_greeting
ALAN_GREETING_COOLDOWN=10

# Alan silence greeting — send greeting video when Alan was silent for >= N hours (0.0 = disabled)
ALAN_SILENCE_GREETING_HOURS=6.0

# Admin user ID for test commands (optional, default: 5885953495)
ADMIN_USER_ID=5885953495

# Better Stack Monitoring (optional — leave empty to disable)
SENTRY_DSN=your_sentry_dsn_here
LOGTAIL_SOURCE_TOKEN=your_logtail_source_token_here

# ── War Words Alert (F5v2 / Epic 10) ──
# Comma-separated Telegram channel IDs to monitor for reposts (like "ЧП Пермь", "Радар БПЛА")
WAR_CHANNEL_IDS=1654872411
# Comma-separated channel usernames (without @). Use this OR channel IDs, or both.
WAR_CHANNEL_USERNAMES=
# Comma-separated reply phrases (random choice). Empty = built-in defaults.
WAR_REPLIES=

# ── Slavic Photo (Epic 12) ──
# Every N "пошёл нахуй" replies → send random media from SLAVIC_RANDOM_DIR
SLAVIC_PHOTO_INTERVAL=10
# Directory with random media files (supports photo/video/animation/gif)
SLAVIC_RANDOM_DIR=media/slavik/slavik_random
# Deprecated — single file fallback if SLAVIC_RANDOM_DIR is empty/missing
# SLAVIC_PHOTO_PATH=media/slavic_na_litso.jpg

# ── Common Service (Epic 15) — otboy + danger detection ──
# Shared cooldown in seconds (0 = no cooldown, every trigger sends)
COMMON_COOLDOWN=0
# Danger-specific cooldown in seconds (additional to shared).
# Danger sends are blocked if EITHER shared OR danger cooldown is active.
# 0 = no additional danger restriction (default: 60.0 = 1 minute).
DANGER_COOLDOWN=60s
# Base directory for common media (subdirs: otboy/, danger/)
COMMON_MEDIA_BASE=media/common
# Comma-separated danger keywords (case-insensitive, Cyrillic word boundaries).
# Leave empty to use built-in defaults (135+ words from filters/word_lists.py).
DANGER_WORDS=

# ── Common Service: selfdev/work (Epic 30) ──
# Пер-сабдир анти-спам (time-format: 5m, 1h, 30s). Блокирует только свой
# сабдир, поверх общего COMMON_COOLDOWN. 0 = без доп. ограничения.
SELFDEV_COOLDOWN=5m
WORK_COOLDOWN=5m
# ── Epic 52 (T-409, D213) ──
# Точечный выключатель work-медиа (media/common/work). false = молчит только work.
# Прод: false (требование пользователя, T-416).
COMMON_WORK_MEDIA_ENABLED=True
# Глобальный рубильник ВСЕХ common-медиа (otboy/danger/selfdev/work).
# На проде НЕ выставляется (T-416).
COMMON_MEDIA_ENABLED=True

# ── Goodmorning (Epic 30) ──
# Время рассылки (HH:MM). Кривой формат → WARNING + fallback 07:00.
GOODMORNING_TIME=07:00
# Часовой пояс расписания.
GOODMORNING_TZ=Asia/Yekaterinburg
# ID чатов через запятую, куда будить. ПУСТО = рассылка ВЫКЛЮЧЕНА
# (планировщик не стартует, WARNING в лог).
GOODMORNING_TARGET_CHAT_IDS=
# Папка с утренним медиа.
GOODMORNING_MEDIA_DIR=media/common/goodmorning

# ── Mimic Feature (common service) ──
# Comma-separated user IDs whose messages will be mimicked. Empty or "0" = disabled.
MIMIC_VICTIM_USER_IDS=138811255
# Minimum word count in victim's message to trigger mimic (> N words)
MIMIC_MIN_WORDS=5
# Cooldown in seconds between mimic replies per (chat, user)
MIMIC_COOLDOWN=1h
# Mimic только на обычные сообщения (не на репосты). True = включая репосты.
MIMIC_FORWARDS_ENABLED=False

# ── Slavik Mimic (replacement for "пошёл нахуй") ──
# Minimum word count in Slava's message for mimic. -1 = disabled.
SLAVIK_MIMIC_MIN_WORDS=5
# Cooldown in seconds between Slavik mimic replies (per chat)
SLAVIK_MIMIC_COOLDOWN=60s

# ── Olya (Epic 19 / Epic 32) ────────────────────────────────
OLYA_ENABLED=True
OLYA_USER_ID=834424825
OLYA_COOLDOWN=60s
OLYA_MEDIA_BASE=media/olya/cringe
# ID юзера/бота SaveAsBot (репосты MessageOriginUser). Через запятую.
OLYA_SAVEASBOT_USER_IDS=523131145
# Канальные ID SaveAsBot (репосты MessageOriginChannel); пусто = не матчим каналы
OLYA_SAVEASBOT_CHANNEL_IDS=
OLYA_CAPTION_ENABLED=True
OLYA_CAPTION_TEXT=Спасибо, что пользуетесь - @SaveAsBot'ом
# Доп. триггер: упоминание @SaveAsBot в caption (любой регистр/дефис)
OLYA_CAPTION_MENTION_ENABLED=True
OLYA_REPOST_ENABLED=True
OLYA_MEDIA_TYPE=video
# True = реагировать на ВСЕ видео Оли. False (дефолт) = только SaveAsBot-видео (репост/caption).
OLYA_ALWAYS_SEND=False

# ── SmartModule: Summary (Epic 24) ─────────────────────────────
# LLM API (OpenAI-совместимый хаб apinet.cloud; провайдер-агностик)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://apinet.cloud/v1
LLM_MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001
# Таймаут и число повторов LLM-запросов (429/5xx/timeout)
LLM_TIMEOUT=30.0
# LLM_MAX_RETRIES=2
# Размерность эмбеддингов для vec0 (gemini-embedding-001 = 3072)
EMBEDDING_DIM=3072
# ── LLM resilience (Epic 47, Section 56) ──
# LLM_RETRY_BACKOFF_BASE=1.0
# LLM_RETRY_BACKOFF_CAP=8.0
# LLM_RETRY_JITTER_MAX=2.0
# LLM_TOTAL_BUDGET=60.0
# ── LLM Circuit Breaker + Fallback (Epic 53, Section 62.6) ──
# CB (скоуп: только direct_chat): N подряд транзиентных фейлов
# (5xx/транспорт/таймаут) → OPEN на LLM_CB_COOLDOWN_SECONDS, затем одна
# half-open пробная генерация → CLOSED/OPEN.
# LLM_CB_ENABLED=True
# LLM_CB_FAILURE_THRESHOLD=3
# LLM_CB_COOLDOWN_SECONDS=300.0
# Фоллбэк-провайдер (опциональный): 1 попытка после исчерпания primary-ретраев.
# Активен ТОЛЬКО если заданы ВСЕ ТРИ ключа; пусто = выключен (ровно старое
# поведение). Секрет — только в .env (R17), в логи не пишется.
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEY=
# ── GraphRAG memorize (Epic 47) ──
# GRAPH_MEMORIZE_MAX_BATCH_RETRIES=2
# GRAPH_MEMORIZE_BATCH_RETRY_BACKOFF=2.0
# ── SummaryGenerator (Epic 47) ──
# SUMMARY_RETRY_ONCE_PAUSE=5.0
# False = сервис отключён (роутеры не регистрируются)
SUMMARY_ENABLED=True
# L1: окно генерации (часы)
SUMMARY_WINDOW_HOURS=6.0
# L2: хранение сырых сообщений (дни), после — сжатие в L3
FULL_MEMORY_RETENTION_DAYS=30
# L3: срок жизни архивных фактов (дни)
ARCHIVE_MEMORY_RETENTION_DAYS=90
# Лимит Telegram: число частей ответа (чанкинг 4096)
MAX_SUMMARY_PARTS=1
# Часовой пояс расписания (00/06/12/18)
SUMMARY_TIMEZONE=Asia/Yekaterinburg
# Пусто = /summary разрешена всем; иначе — только перечисленным ID (через запятую)
ALLOWED_SUMMARY_IDS=
# false = /summary доступна всем (или по списку ALLOWED_SUMMARY_IDS); true = только ADMIN_USER_ID (Epic 31/D94)
SUMMARY_ADMIN_ONLY=False
# JSON-словарь алиасов: {"<user_id>": "<alias>"}
SUMMARY_ALIASES={"5885953495":"Никита","468142125":"Настя","42115912":"Макс","401198097":"Света","806457110":"Цибуля","350803143":"Костя","620272635":"Черемных","263719784":"Глеб","5155552514":"Алена","138811255":"Леха","529151103":"Толян","834424825":"Оля","479167456":"Славик","972412990":"Леха Крейсер","1313107079":"Вася","1060441536":"Врач","350318933":"Серега Гамма","146761791":"Инкуфен","5929079345":"Кировский","1276415576":"Никита Философ","284628202":"Даня","888365120":"Миша Слушай","155169707":"Сава","241922756":"Амалия","8565110113":"Дотер","1031832774":"ЕкбЭшник с номером 13","134812796":"Ринтара","1878452291":"Диана","198575800":"Александр Темников","1050678029":"Никита Вахтовик","1782540737":"Лиля","1055349583":"Левин","649130988":"Юлика","1038598547":"Дианин муж","254345362":"Зеля","6221730408":"Марк"}
# Троттлинг ручного /summary (секунды)
SUMMARY_THROTTLE_SECONDS=60.0
# Пауза между чанками ответа (секунды, лимиты Telegram)
SUMMARY_CHUNK_DELAY=2.0
# Пусто = саммари во все чаты, где есть сообщения; иначе — перечисленные chat_id
SUMMARY_TARGET_CHAT_IDS=
# Капы окна L1 (риск 6)
SUMMARY_MAX_WINDOW_MESSAGES=500
SUMMARY_MAX_MESSAGE_CHARS=2000
SUMMARY_MAX_CONTEXT_CHARS=120000
# Лимиты RAG
SUMMARY_RAG_L2_LIMIT=10
SUMMARY_RAG_L3_LIMIT=10
# Размер пачки сжатия L3
SUMMARY_COMPRESS_BATCH=100

# ── GraphRAG (Epic 26) ─────────────────────────────────────────
# True = извлекать граф связей (узлы/рёбра) при архивации: ровно 1 доп. LLM-вызов на пачку.
# False = аварийный рубильник: extraction не вызывается, поведение ровно как до фичи.
GRAPH_RAG_ENABLED=True
# Инкремент веса ребра при повторном упоминании связи (дедуп через UNIQUE + weight)
GRAPH_EDGE_WEIGHT_INCREMENT=1
# Сколько рёбер-справок «[Историческая справка: …]» подмешивать в /summary
GRAPH_TOP_EDGES_LIMIT=5
# Максимум триплетов, сохраняемых за один extraction-вызов
GRAPH_EXTRACT_MAX_TRIPLETS=50

# ── GraphRAG v2 (Epic 46, D175/D177) ──
# EMBEDDING_DIM=3072
# GRAPH_FACT_TTL_DAYS=14
# GRAPH_RAG_FACTS_LIMIT=10
# GRAPH_RAG_CONTEXT_MAX_CHARS=2000

# ── SmartModule: FactCheck + SmartSearch (Epic 33) ──────────
# Ключи поисковиков; пусто = уровень каскада отключён. Секреты — только в .env
TAVILY_API_KEY=
EXA_API_KEY=
# Длина LLM-ответа, символы (значения <100 игнорируются, дефолт 4000)
SEARCH_MAX_SYMBOLS=4000
FACTCHECK_MAX_SYMBOLS=4000
# Кулдауны per (chat, user), секунды (отрицательные игнорируются, дефолт 300)
SEARCH_COOLDOWN_SECONDS=300
FACTCHECK_COOLDOWN_SECONDS=300

# ── SmartModule: YouTube + Web (Epic 37) ─────────────────────
# Длина LLM-ответа и лимит контекста, символы (значения <100 игнорируются, дефолт 4000)
YOUTUBE_MAX_SYMBOLS=4000
WEBPAGE_MAX_SYMBOLS=4000
# Кулдауны per (chat, user), секунды (отрицательные игнорируются, дефолт 300)
YOUTUBE_COOLDOWN_SECONDS=300
WEBPAGE_COOLDOWN_SECONDS=300

# ── SmartModule: YouTube engine failover (Epic 39) ─────────────
# Прокси для yt-dlp и youtube-transcript-api (http://[user:pass@]host:port).
# Пусто = выключено. Секрет — только в .env; в логи не пишется (R17).
YOUTUBE_TRANSCRIPT_PROXY_URL=
# Путь к файлу cookies (Netscape-формат) для yt-dlp и youtube-transcript-api.
# Пусто = выключено.
YOUTUBE_COOKIES_FILE=

# ── Checkup (Epic 42) ──
CHECKUP_COOLDOWN_SECONDS=300
CHECKUP_MAX_SYMBOLS=3000
# CHECKUP_JOURNALCTL_CMD=journalctl -u admin_bot -n 300 --no-pager
# ── Checkup 400 (Epic 49, Section 57.5) ──
# CHECKUP_MAX_INPUT_SYMBOLS=12000

# ── Checkup: Betterstack SQL API (Epic 45, D172) ──
# ClickHouse HTTP-коннекшн. Пустые USER/PASSWORD → облачная ступень пропущена.
# CHECKUP_BETTERSTACK_SQL_HOST=https://eu-fsn-3-connect.betterstackdata.com
CHECKUP_BETTERSTACK_SQL_USER=
CHECKUP_BETTERSTACK_SQL_PASSWORD=
# Префикс сорса логов (t<id>_<source>, из Integrations → «Query with»).
CHECKUP_BETTERSTACK_SQL_TABLE=
# Полный SQL-оверрайд (если задан — используется вместо шаблона 54.3).
# CHECKUP_BETTERSTACK_SQL_QUERY=

# ── /info + /edit_info (Epic 43) ──
INFO_COOLDOWN_SECONDS=300
# INFO_TEXT_FILE=info_text.md

# ── DirectChat (Epic 50, Section 58) ──
# Epic 52 (T-411, R52-4): keyword-триггер «бот»/«ботохуета»/«ботина»/«ботяра»/
# «ботик»/«ботохуйня» с word-boundary («робот»/«ботва» НЕ триггерят).
# false = keyword-ветка молчит (reply на бота и mention работают как раньше).
DIRECT_CHAT_BOTWORD_ENABLED=True
# Epic 60 (67.2, T-492, правило п.49): keyword-regex «бот»-семьи — КОНФИГ, не код.
# Дефолт байт-в-байт равен старому литералу; невалидный regex → WARNING + дефолт.
# CHAT_BOTWORD_PATTERN=(?i)(?<![0-9a-zа-яё_./])бот(?:ина|яра|ик|охуета|охуйня)?(?![0-9a-zа-яё_])
# Последние сообщений чата для фона <Global_Context> (58.6).
CHAT_GLOBAL_CONTEXT_LIMIT=100
# Token Bucket: обращений подряд до кулдауна (58.5).
CHAT_BURST_LIMIT=3
# Полное восстановление зарядов после последнего допущенного обращения, сек.
CHAT_COOLDOWN_SECONDS=300
# TTL памяти bot_direct_reply-фактов, дней. ПУСТО = expires_at NULL (вечное, по ТЗ).
CHAT_DIRECT_REPLY_TTL_DAYS=
# Потолок символов <Global_Context>.
# CHAT_GLOBAL_CONTEXT_MAX_CHARS=4000
# Глубина рекурсии reply-цепочки <Conversation_Thread>.
# CHAT_THREAD_MAX_DEPTH=6
# Потолок символов <Conversation_Thread>.
# CHAT_THREAD_MAX_CHARS=2000

# ── Smart Cache (Epic 51, Section 59.2) ──
# Exact Match Cache: False = выключен (по умолчанию). True — только с ведома
# владельца (деплой T-407).
SMART_CACHE_ENABLED=False
# TTL кэш-строк, сек (30 мин).
# SMART_CACHE_TTL_SECONDS=1800
# Потолок строк таблицы smart_cache (ленивая очистка старейших).
# SMART_CACHE_MAX_ROWS=1000

# ── Epic 60 Фаза A (Section 63.5, R60-1/R60-2) ──
# Персистентный троттлинг в БД (throttle_state + bot_replies, миграция v3).
# False = ровно старые in-memory счётчики (аварийный рубильник).
THROTTLE_PERSISTENT_ENABLED=True
# Таймаут ожидания per-chat замка генерации direct_chat, сек. Таймаут →
# CHAT_LOCK_BUSY_PHRASES.
# CHAT_LOCK_WAIT_SECONDS=60.0
# Потолок словаря per-chat замков (ленивая чистка незалоченных).
# CHAT_LOCK_MAX_ENTRIES=256

# ── Epic 60 Фаза B (Section 64.8, R60-3…R60-9) ──
# Дедуп фактов при записи (64.1): cosine ≥ HIGH → пропуск (+подтверждение),
# [LOW, HIGH) → supersede (старый инвалидируется, новый unconfirmed), < LOW → добавление.
# False = ровно старое поведение.
GRAPH_DEDUP_ENABLED=True
# GRAPH_DEDUP_SIMILARITY_HIGH=0.95
# GRAPH_DEDUP_SIMILARITY_LOW=0.85
# GRAPH_DEDUP_WEIGHT_BONUS=0.1
# GRAPH_UNCONFIRMED_RETENTION_DAYS=14
# Бэкап БД раз в день (VACUUM INTO) + текстовый экспорт фактов (facts_*.txt);
# ротация: последние MEMORY_BACKUP_KEEP файлов. False = джоб не стартует.
MEMORY_BACKUP_ENABLED=True
# MEMORY_BACKUP_DIR=backups
# MEMORY_BACKUP_KEEP=7
# MEMORY_BACKUP_HOUR=05:00
# Кэш эмбеддингов (текст → вектор): SHA-256-ключ, TTL дней, LRU-cap строк.
# False = ровно старое поведение (каждый вызов — в API).
EMBED_CACHE_ENABLED=True
# EMBED_CACHE_TTL_DAYS=30
# EMBED_CACHE_MAX_ROWS=50000
# Метрики здоровья памяти в чекап: data-секция <memory_health> в user-контенте;
# CHECKUP_SYSTEM_PROMPT не меняется.
CHECKUP_MEMORY_METRICS_ENABLED=True
# Бегущий конспект при CHAT_CONTEXT_FILL_RATIO × окна; хвост дословно; TTL минут.
CHAT_RUNNING_SUMMARY_ENABLED=True
# CHAT_CONTEXT_FILL_RATIO=0.8
# CHAT_RUNNING_SUMMARY_TAIL=30
# RUNNING_SUMMARY_TTL_MINUTES=60
# Лимиты в токенах (tiktoken, o200k_base): только сборка direct_chat/summary.
# Пустой токенный при заданном chars → chars-fallback (WARNING).
# TOKENIZER_ENCODING=o200k_base
# TOKEN_SAFETY_MULTIPLIER=1.15
# CHAT_GLOBAL_CONTEXT_MAX_TOKENS=1000
# CHAT_THREAD_MAX_TOKENS=500
# SUMMARY_MAX_CONTEXT_TOKENS=30000

# Эпик 60 Фаза C (Section 65.11, R60-10…R60-19) — direct_chat UX.
# Стачка кулдаунов: N кулдаунов подряд → молчание без фразы. False = стачка не считается.
CHAT_SILENCE_ENABLED=True
# CHAT_SILENCE_AFTER_COOLDOWNS=5
# Стилевые якоря: секция <style_anchors> с последними ответами бота.
CHAT_STYLE_ANCHORS_ENABLED=True
# CHAT_STYLE_ANCHORS_COUNT=3
# CHAT_STYLE_ANCHOR_MAX_CHARS=400
# Настроение собеседника: user-блок <mood> по словам (comma-separated).
# Системный промпт R50-4 не меняется.
CHAT_MOOD_ENABLED=True
# CHAT_MOOD_NEGATIVE_WORDS=бля,нахуй,заебал,сука,бесит,пидор,гандон,тупой
# CHAT_MOOD_POSITIVE_WORDS=спс,спасибо,класс,топ,кайф,красава,супер
# Стриминг ТОЛЬКО саммари (placeholder + edit): тест-режим D238. False = обычная отправка.
SUMMARY_STREAMING_ENABLED=False
# SUMMARY_STREAM_EDIT_INTERVAL_PRIVATE=1.0
# SUMMARY_STREAM_EDIT_INTERVAL_GROUP=3.0
# Индикатор «печатает…» (ChatActionSender) вокруг LLM-точек, без искусственной паузы.
TYPING_INDICATOR_ENABLED=True
# TYPING_INTERVAL_SECONDS=5.0
# Temperature-пресеты (точный/сбалансированный/болтливый); только direct_chat.
# CHAT_TEMPERATURE_PRECISE=0.0
# CHAT_TEMPERATURE_BALANCED=0.7
# CHAT_TEMPERATURE_CHATTY=1.0
# CHAT_TEMPERATURE_PRESET_DEFAULT=balanced

# ── Epic 60 Фаза D (Section 66.13, R60-20…R60-31) ──
# Веса значимости (66.1): стартовый вес по origin; вес влияет на TTL
# (expires_at = now + TTL × (0.5 + weight)).
# GRAPH_FACT_WEIGHT_DIRECT=0.7
# GRAPH_FACT_WEIGHT_ARCHIVE=0.4
# Слияние повторяющихся эпизодов (66.2): фоновая задача раз в N дней.
GRAPH_EPISODE_MERGE_ENABLED=True
# GRAPH_EPISODE_MERGE_INTERVAL_DAYS=7
# GRAPH_EPISODE_MERGE_BATCH=20
# GRAPH_EPISODE_MERGE_MAX_FACTS_PER_CLUSTER=5
# Time-decay (66.3): w_eff = weight × 0.5^(Δдней/half_life) при чтении.
GRAPH_TIME_DECAY_ENABLED=True
# GRAPH_TIME_DECAY_HALF_LIFE_DAYS=60
# GRAPH_TIME_DECAY_FLOOR=0.1
# Квота памяти на человека (66.4): прямые факты; 0 = без лимита.
GRAPH_USER_QUOTA_ENABLED=True
# GRAPH_FACTS_PER_USER_QUOTA=50
# TTL+LRU touch (66.5): RAG-hit продлевает expires_at (cap 2×TTL).
GRAPH_FACT_TOUCH_ENABLED=True
# GRAPH_FACT_TOUCH_EXTEND_DAYS=7
# Сжатие векторов (66.6): int8-coarse + float-реранк (sqlite-vec). False = float-only.
VEC_INT8_ENABLED=True
# MMR-разнообразие (66.8): fetch_k кандидатов → greedy MMR (λ) → top-k.
GRAPH_MMR_ENABLED=True
# GRAPH_MMR_LAMBDA=0.6
# GRAPH_MMR_FETCH_K=20
# Периодический пересмотр фактов (66.11): склейка/выброс/усечение лога.
GRAPH_REVIEW_ENABLED=True
# GRAPH_REVIEW_INTERVAL_DAYS=3
# GRAPH_COMPRESSION_LOG_RETENTION_DAYS=90
# Бюджеты контекста direct_chat (66.12): доли от CHAT_CONTEXT_BUDGET_TOKENS.
CHAT_CONTEXT_BUDGETS_ENABLED=True
# CHAT_CONTEXT_BUDGET_TOKENS=4000
# CHAT_BUDGET_MAP_RATIO=0.05
# CHAT_BUDGET_GLOBAL_RATIO=0.30
# CHAT_BUDGET_THREAD_RATIO=0.20
# CHAT_BUDGET_RAG_RATIO=0.15
# CHAT_BUDGET_TARGET_RATIO=0.05
# CHAT_BUDGET_ANCHORS_RATIO=0.05
# CHAT_BUDGET_RESPONSE_RATIO=0.20
# CHAT_BUDGET_RESERVE_RATIO=0.10

# ── Epic 60 Фаза E (Section 67.4, R60-35, T-499) ──
# п.8 дедуп одинаковых текстов подряд direct_chat: ключ «чат+человек+текст»
# в smart_cache (slug direct_dedup); повтор в течение TTL → повтор ответа из
# кэша (или молчание, если в прошлый раз ответа не было). Троттлинг остаётся
# первым барьером; SMART_CACHE_ENABLED дедуп НЕ выключает.
CHAT_DEDUP_ENABLED=True
# CHAT_DEDUP_TTL_SECONDS=300
