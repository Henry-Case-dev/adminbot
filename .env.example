# Telegram Bot Token (REQUIRED)
API_TOKEN=your_telegram_bot_token_here

# Database path (optional, default: local_database.db)
DB_PATH=local_database.db

# Media directory (optional, default: media)
MEDIA_BASE=media

# User IDs (optional, defaults below)
SLAVIK_USER_ID=479167456
KOSTIK_USER_ID=350803143
ALAN_USER_ID=138811255

# Alan reply interval — bot replies with random phrase every N messages (optional, default: 10)
ALAN_REPLY_INTERVAL=10

# Kostik reply probability — 0.0 to 1.0 (optional, default: 1.0 = reply to every message)
KOSTIK_REPLY_PROBABILITY=1.0

# Dead Page V2 — Repost-triggered (optional, defaults below)
DEAD_PAGE_SOURCE_CHANNEL_USERNAME=d_pages
DEAD_PAGE_SOURCE_CHANNEL_ID=0
DEAD_PAGE_RELAY_CHANNEL_ID=-1004228645624
DEAD_PAGE_CAPTION_MAX_CHARS=1024
DEAD_PAGE_COOLDOWN=10s
DEAD_PAGE_POST_ON_JOIN=False
DEAD_PAGE_MAX_FORWARD_RETRIES=5

# GIF — send mp4 every N messages (optional, default: 5)
# Файл: media/slavik/slavic_chlen.mp4 (переехал из media/ в v2.15.0)
# interval <= 0 = гифка выключена (guard, WARNING в лог)
GIF_INTERVAL=5
GIF_PATH=media/slavik/slavic_chlen.mp4

# Dead page media directory (optional)
DEAD_PAGE_DIR=media/dead_page

# Alan greeting video (F7) — random video sent when Alan joins (optional, defaults below)
ALAN_USERNAME=@Alan_Z
ALAN_GREETING_DIR=media/leha_greeting
ALAN_GREETING_COOLDOWN=10

# Alan silence greeting — send greeting video when Alan was silent for >= N hours (0.0 = disabled)
ALAN_SILENCE_GREETING_HOURS=6.0

# Admin user ID for test commands (optional, default: 5885953495)
ADMIN_USER_ID=5885953495

# Better Stack Monitoring (optional — leave empty to disable)
SENTRY_DSN=your_sentry_dsn_here
LOGTAIL_SOURCE_TOKEN=your_logtail_source_token_here

# ── War Words Alert (F5v2 / Epic 10) ──
# Comma-separated Telegram channel IDs to monitor for reposts (like "ЧП Пермь", "Радар БПЛА")
WAR_CHANNEL_IDS=1654872411
# Comma-separated channel usernames (without @). Use this OR channel IDs, or both.
WAR_CHANNEL_USERNAMES=
# Comma-separated reply phrases (random choice). Empty = built-in defaults.
WAR_REPLIES=

# ── Slavic Photo (Epic 12) ──
# Every N "пошёл нахуй" replies → send random media from SLAVIC_RANDOM_DIR
SLAVIC_PHOTO_INTERVAL=10
# Directory with random media files (supports photo/video/animation/gif)
SLAVIC_RANDOM_DIR=media/slavik/slavik_random
# Deprecated — single file fallback if SLAVIC_RANDOM_DIR is empty/missing
# SLAVIC_PHOTO_PATH=media/slavic_na_litso.jpg

# ── Common Service (Epic 15) — otboy + danger detection ──
# Shared cooldown in seconds (0 = no cooldown, every trigger sends)
COMMON_COOLDOWN=0
# Danger-specific cooldown in seconds (additional to shared).
# Danger sends are blocked if EITHER shared OR danger cooldown is active.
# 0 = no additional danger restriction (default: 60.0 = 1 minute).
DANGER_COOLDOWN=60s
# Base directory for common media (subdirs: otboy/, danger/)
COMMON_MEDIA_BASE=media/common
# Comma-separated danger keywords (case-insensitive, Cyrillic word boundaries).
# Leave empty to use built-in defaults (135+ words from filters/word_lists.py).
DANGER_WORDS=

# ── Common Service: selfdev/work (Epic 30) ──
# Пер-сабдир анти-спам (time-format: 5m, 1h, 30s). Блокирует только свой
# сабдир, поверх общего COMMON_COOLDOWN. 0 = без доп. ограничения.
SELFDEV_COOLDOWN=5m
WORK_COOLDOWN=5m

# ── Goodmorning (Epic 30) ──
# Время рассылки (HH:MM). Кривой формат → WARNING + fallback 07:00.
GOODMORNING_TIME=07:00
# Часовой пояс расписания.
GOODMORNING_TZ=Asia/Yekaterinburg
# ID чатов через запятую, куда будить. ПУСТО = рассылка ВЫКЛЮЧЕНА
# (планировщик не стартует, WARNING в лог).
GOODMORNING_TARGET_CHAT_IDS=
# Папка с утренним медиа.
GOODMORNING_MEDIA_DIR=media/common/goodmorning

# ── Mimic Feature (common service) ──
# Comma-separated user IDs whose messages will be mimicked. Empty or "0" = disabled.
MIMIC_VICTIM_USER_IDS=138811255
# Minimum word count in victim's message to trigger mimic (> N words)
MIMIC_MIN_WORDS=5
# Cooldown in seconds between mimic replies per (chat, user)
MIMIC_COOLDOWN=1h
# Mimic только на обычные сообщения (не на репосты). True = включая репосты.
MIMIC_FORWARDS_ENABLED=False

# ── Slavik Mimic (replacement for "пошёл нахуй") ──
# Minimum word count in Slava's message for mimic. -1 = disabled.
SLAVIK_MIMIC_MIN_WORDS=5
# Cooldown in seconds between Slavik mimic replies (per chat)
SLAVIK_MIMIC_COOLDOWN=60s

# ── Olya (Epic 19 / Epic 32) ────────────────────────────────
OLYA_ENABLED=True
OLYA_USER_ID=834424825
OLYA_COOLDOWN=60s
OLYA_MEDIA_BASE=media/olya/cringe
# ID юзера/бота SaveAsBot (репосты MessageOriginUser). Через запятую.
OLYA_SAVEASBOT_USER_IDS=523131145
# Канальные ID SaveAsBot (репосты MessageOriginChannel); пусто = не матчим каналы
OLYA_SAVEASBOT_CHANNEL_IDS=
OLYA_CAPTION_ENABLED=True
OLYA_CAPTION_TEXT=Спасибо, что пользуетесь - @SaveAsBot'ом
# Доп. триггер: упоминание @SaveAsBot в caption (любой регистр/дефис)
OLYA_CAPTION_MENTION_ENABLED=True
OLYA_REPOST_ENABLED=True
OLYA_MEDIA_TYPE=video
# True = реагировать на ВСЕ видео Оли. False (дефолт) = только SaveAsBot-видео (репост/caption).
OLYA_ALWAYS_SEND=False

# ── SmartModule: Summary (Epic 24) ─────────────────────────────
# LLM API (OpenAI-совместимый хаб apinet.cloud; провайдер-агностик)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://apinet.cloud/v1
LLM_MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001
# Таймаут и число повторов LLM-запросов (429/5xx/timeout)
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2
# Размерность эмбеддингов для vec0 (gemini-embedding-001 = 768)
EMBEDDING_DIM=768
# False = сервис отключён (роутеры не регистрируются)
SUMMARY_ENABLED=True
# L1: окно генерации (часы)
SUMMARY_WINDOW_HOURS=6.0
# L2: хранение сырых сообщений (дни), после — сжатие в L3
FULL_MEMORY_RETENTION_DAYS=30
# L3: срок жизни архивных фактов (дни)
ARCHIVE_MEMORY_RETENTION_DAYS=90
# Лимит Telegram: число частей ответа (чанкинг 4096)
MAX_SUMMARY_PARTS=1
# Часовой пояс расписания (00/06/12/18)
SUMMARY_TIMEZONE=Asia/Yekaterinburg
# Пусто = /summary разрешена всем; иначе — только перечисленным ID (через запятую)
ALLOWED_SUMMARY_IDS=
# false = /summary доступна всем (или по списку ALLOWED_SUMMARY_IDS); true = только ADMIN_USER_ID (Epic 31/D94)
SUMMARY_ADMIN_ONLY=False
# JSON-словарь алиасов: {"<user_id>": "<alias>"}
SUMMARY_ALIASES={"5885953495":"Никита","468142125":"Настя","42115912":"Макс","401198097":"Света","806457110":"Цибуля","350803143":"Костя","620272635":"Черемных","263719784":"Глеб","5155552514":"Алена","138811255":"Леха","529151103":"Толян","834424825":"Оля","479167456":"Славик","972412990":"Леха Крейсер","1313107079":"Вася","1060441536":"Врач","350318933":"Серега Гамма","146761791":"Инкуфен","5929079345":"Кировский","1276415576":"Никита Философ","284628202":"Даня","888365120":"Миша Слушай","155169707":"Сава","241922756":"Амалия","8565110113":"Дотер","1031832774":"ЕкбЭшник с номером 13","134812796":"Ринтара","1878452291":"Диана","198575800":"Александр Темников","1050678029":"Никита Вахтовик","1782540737":"Лиля","1055349583":"Левин","649130988":"Юлика","1038598547":"Дианин муж","254345362":"Зеля","6221730408":"Марк"}
# Троттлинг ручного /summary (секунды)
SUMMARY_THROTTLE_SECONDS=60.0
# Пауза между чанками ответа (секунды, лимиты Telegram)
SUMMARY_CHUNK_DELAY=2.0
# Пусто = саммари во все чаты, где есть сообщения; иначе — перечисленные chat_id
SUMMARY_TARGET_CHAT_IDS=
# Капы окна L1 (риск 6)
SUMMARY_MAX_WINDOW_MESSAGES=500
SUMMARY_MAX_MESSAGE_CHARS=2000
SUMMARY_MAX_CONTEXT_CHARS=120000
# Лимиты RAG
SUMMARY_RAG_L2_LIMIT=10
SUMMARY_RAG_L3_LIMIT=10
# Размер пачки сжатия L3
SUMMARY_COMPRESS_BATCH=100

# ── GraphRAG (Epic 26) ─────────────────────────────────────────
# True = извлекать граф связей (узлы/рёбра) при архивации: ровно 1 доп. LLM-вызов на пачку.
# False = аварийный рубильник: extraction не вызывается, поведение ровно как до фичи.
GRAPH_RAG_ENABLED=True
# Инкремент веса ребра при повторном упоминании связи (дедуп через UNIQUE + weight)
GRAPH_EDGE_WEIGHT_INCREMENT=1
# Сколько рёбер-справок «[Историческая справка: …]» подмешивать в /summary
GRAPH_TOP_EDGES_LIMIT=5
# Максимум триплетов, сохраняемых за один extraction-вызов
GRAPH_EXTRACT_MAX_TRIPLETS=50

# ── SmartModule: FactCheck + SmartSearch (Epic 33) ──────────
# Ключи поисковиков; пусто = уровень каскада отключён. Секреты — только в .env
TAVILY_API_KEY=
EXA_API_KEY=
# Длина LLM-ответа, символы (значения <100 игнорируются, дефолт 4000)
SEARCH_MAX_SYMBOLS=4000
FACTCHECK_MAX_SYMBOLS=4000
# Кулдауны per (chat, user), секунды (отрицательные игнорируются, дефолт 300)
SEARCH_COOLDOWN_SECONDS=300
FACTCHECK_COOLDOWN_SECONDS=300

# ── SmartModule: YouTube + Web (Epic 37) ─────────────────────
# Длина LLM-ответа и лимит контекста, символы (значения <100 игнорируются, дефолт 4000)
YOUTUBE_MAX_SYMBOLS=4000
WEBPAGE_MAX_SYMBOLS=4000
# Кулдауны per (chat, user), секунды (отрицательные игнорируются, дефолт 300)
YOUTUBE_COOLDOWN_SECONDS=300
WEBPAGE_COOLDOWN_SECONDS=300